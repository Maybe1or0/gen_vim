{
  "name": "genvim",
  "displayName": "GENVIM",
  "description": "Play focus videos beside your code and add your own local playlist.",
  "version": "1.0.0",
  "publisher": "maybe1or0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maybe1or0/gen_vim.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "video",
    "focus",
    "productivity",
    "sidebar"
  ],
  "main": "./extension.js",
  "files": [
    "extension.js",
    "media/**",
    "genvimSetup/brainrotvideos/brainrot1.mp4",
    "genvimSetup/brainrotvideos/brainrot3.mp4",
    "genvimSetup/brainrotvideos/brainrot4.mp4",
    "genvimSetup/brainrotvideos/brainrot5.mp4",
    "genvim_example.png",
    "README.md",
    "RELEASE.md",
    "LICENSE"
  ],
  "activationEvents": [
    "onView:genvim.videoView",
    "onCommand:genvim.addVideos",
    "onCommand:genvim.selectVideo",
    "onCommand:genvim.nextVideo",
    "onCommand:genvim.removeCurrentVideo",
    "onCommand:genvim.openSettings",
    "onCommand:genvim.clearCustomVideos"
  ],
  "scripts": {
    "audit": "npm audit --audit-level=high",
    "check": "node --check extension.js && node --check media/sidebar.js && node --check scripts/validate-extension.js && node --check test/run-tests.js && node --check test/suite/index.js",
    "validate": "node scripts/validate-extension.js",
    "test": "node test/run-tests.js",
    "package": "vsce package",
    "ci": "npm run check && npm run validate && npm run audit"
  },
  "contributes": {
    "commands": [
      {
        "command": "genvim.addVideos",
        "title": "Add Videos",
        "category": "GENVIM",
        "icon": "$(add)"
      },
      {
        "command": "genvim.selectVideo",
        "title": "Select Video",
        "category": "GENVIM",
        "icon": "$(list-selection)"
      },
      {
        "command": "genvim.nextVideo",
        "title": "Play Next Video",
        "category": "GENVIM",
        "icon": "$(arrow-right)"
      },
      {
        "command": "genvim.removeCurrentVideo",
        "title": "Remove Current Video",
        "category": "GENVIM",
        "icon": "$(trash)"
      },
      {
        "command": "genvim.clearCustomVideos",
        "title": "Clear Custom Videos",
        "category": "GENVIM",
        "icon": "$(clear-all)"
      },
      {
        "command": "genvim.openSettings",
        "title": "Open Settings",
        "category": "GENVIM",
        "icon": "$(gear)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "genvim",
          "title": "GENVIM",
          "icon": "media/genvim.svg"
        }
      ]
    },
    "views": {
      "genvim": [
        {
          "type": "webview",
          "id": "genvim.videoView",
          "name": "Focus Player"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "genvim.selectVideo",
          "when": "view == genvim.videoView",
          "group": "navigation@1"
        },
        {
          "command": "genvim.nextVideo",
          "when": "view == genvim.videoView",
          "group": "navigation@2"
        },
        {
          "command": "genvim.addVideos",
          "when": "view == genvim.videoView",
          "group": "navigation@3"
        },
        {
          "command": "genvim.openSettings",
          "when": "view == genvim.videoView",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "GENVIM",
      "properties": {
        "genvim.autoplay": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Start the selected video automatically when the GENVIM view opens."
        },
        "genvim.muted": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Mute video playback. Keeping this enabled allows reliable autoplay."
        },
        "genvim.loop": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Loop the current video. When disabled, GENVIM advances to the next video."
        },
        "genvim.showControls": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show the native video playback controls over the video."
        },
        "genvim.videoFit": {
          "type": "string",
          "default": "cover",
          "scope": "window",
          "enum": [
            "cover",
            "contain",
            "fill"
          ],
          "enumDescriptions": [
            "Fill the entire sidebar and crop overflow.",
            "Show the entire video with possible empty space.",
            "Stretch the video to the sidebar dimensions."
          ],
          "description": "Control how the video fills the GENVIM sidebar."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0"
  }
}
